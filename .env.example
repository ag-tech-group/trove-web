VITE_API_URL=http://localhost:8000

# Sentry error monitoring — leave blank to keep it disabled locally.
# Setting it locally is supported and useful for verifying the integration
# end to end; just mind the org quota if you leave it on.
VITE_SENTRY_DSN=

# Fraction of transactions traced, "0" to "1". Defaults to 0.1 in
# src/lib/error-monitoring.ts. Set to 0 to silence tracing entirely.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog web analytics — leave blank to keep analytics disabled locally
VITE_POSTHOG_KEY=

# PostHog ingest host. Production points this at the first-party reverse proxy
# so content blockers cannot drop events by blocking *.i.posthog.com — the
# /relay locations in nginx.conf.template forward it server-side:
#   VITE_POSTHOG_HOST=https://trovebox.io/relay
# Leave it at PostHog US cloud for local dev, where there is no proxy to hit.
VITE_POSTHOG_HOST=https://us.i.posthog.com
